{
  "name": "livingdoc",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation that cannot be published while it is false",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf packages/cli/dist",
    "clean:checks": "rm -f tests/explain/vitest/*.test.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "livingdoc": "tsx packages/cli/src/bin.ts",
    "generate": "node packages/cli/dist/bin.js generate",
    "dogfood": "npm run clean:checks && npm run typecheck && npm run generate && vitest run tests/",
    "checks": "npm run typecheck && npm run generate && npm test"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
